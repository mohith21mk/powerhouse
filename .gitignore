# ==============================
# POWER HOUSE - Git Ignore
# ==============================

# Node / Vite
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example
!.env.*.example

# Database files
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# User uploaded files
uploads/
backend/uploads/
/var/data/uploads/

# Test / coverage
.coverage
htmlcov/
coverage.xml
.pytest_cache/

# Build / cache
.cache/
.parcel-cache/

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# OS
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Certificates / private keys
*.pem
*.key
*.crt

# Temporary files
*.tmp
*.temp
